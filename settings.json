{
  "cleanupPeriodDays": 7,
  "env": {
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "MAX_THINKING_TOKENS": "10000",
    "ECC_SESSION_START_CONTEXT": "off",
    "ECC_HOOK_PROFILE": "minimal",
    "ECC_DISABLED_HOOKS": "post:edit:typecheck,pre:bash:tmux-reminder"
  },
  "permissions": {
    "allow": [
      "Bash(terraform plan *)",
      "Bash(terraform validate)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform state list)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker inspect *)",
      "Bash(docker logs *)",
      "Bash(docker stats *)",
      "Bash(docker network ls *)",
      "Bash(docker volume ls *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose images *)",
      "Bash(docker service ls *)",
      "Bash(docker service inspect *)",
      "Bash(docker service logs *)",
      "Bash(docker service ps *)",
      "Bash(ansible-playbook --check *)",
      "Bash(ansible --list-hosts *)",
      "Bash(ansible --list-tasks *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl rollout status *)",
      "Bash(kubectl rollout history *)",
      "Bash(helm list *)",
      "Bash(helm diff *)",
      "Bash(helm show *)",
      "Bash(helm template *)",
      "Bash(helm upgrade --install * --dry-run)",
      "Bash(flux get *)",
      "Bash(flux logs *)",
      "Bash(flux diff *)",
      "Bash(kubeseal --fetch-cert *)",
      "Bash(kubectl get sealedsecrets *)",
      "Bash(talosctl version *)",
      "Bash(talosctl health *)",
      "Bash(talosctl get *)",
      "Bash(talosctl logs *)",
      "Bash(talosctl dmesg *)",
      "Bash(talosctl dashboard *)",
      "Bash(task --list*)",
      "Bash(task * --dry-run)",
      "Bash(jq *)",
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote -v)",
      "Read(./terraform/*)",
      "Read(./docker/*)",
      "Read(./.env.example)",
      "Read(./stack.env)",
      "Grep(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(chmod 000 *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state rm *)",
      "Bash(terraform state mv *)",
      "Bash(docker push *)",
      "Bash(docker rm -f *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl label *)",
      "Bash(kubectl annotate *)",
      "Bash(docker exec *)",
      "Bash(helm install *)",
      "Bash(helm uninstall *)",
      "Bash(helm upgrade --install * --values *)",
      "Bash(kubectl scale *)",
      "Bash(terraform state push *)",
      "Bash(talosctl reboot *)",
      "Bash(talosctl reset *)",
      "Bash(talosctl upgrade *)",
      "Bash(talosctl apply-config *)",
      "Bash(flux delete *)",
      "Bash(flux suspend *)",
      "Write(/etc/*)",
      "Write(/root/*)",
      "Write(*.prod.yml)",
      "Write(*.prod.yaml)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash(terraform plan *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'Plan:|No changes|Resource will be|Error:|Warning:' || echo 'Plan summary not found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(terraform show *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'Plan:|No changes|Resource will be|Error:|Warning:' || echo 'Plan summary not found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(docker logs *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'ERROR|WARN|Exception|failed|error' || echo 'No errors found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(docker compose logs *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'ERROR|WARN|Exception|failed|error' || echo 'No errors found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(docker ps *)",
        "hooks": [
          {
            "type": "command",
            "command": "tail -20",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(docker service ls *)",
        "hooks": [
          {
            "type": "command",
            "command": "tail -20",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(docker inspect *)",
        "hooks": [
          {
            "type": "command",
            "command": "tail -20",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(ansible-playbook --check *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'CHANGED|FAILED|ok|ERROR|TASK' || echo 'Run summary not captured'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(kubectl diff *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E '^[+-]' | grep -v '^---\\|^+++' || echo 'No diff output'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(kubectl logs *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'ERROR|WARN|Exception|panic|fatal|error' || echo 'No errors found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(kubectl rollout status *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'successfully rolled out|Waiting|error' || echo 'Rollout status not captured'",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/everything-claude-code.git"
      },
      "autoUpdate": true
    }
  },
  "autoMemoryDirectory": ".claude/memory",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "compactOnSave": true,
  "tui": "fullscreen"
}
