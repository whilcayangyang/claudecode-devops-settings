{
  "cleanupPeriodDays": 7,
  "env": {
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "MAX_THINKING_TOKENS": "4000"
  },
  "permissions": {
    "allow": [
      "Bash(terraform plan *)",
      "Bash(terraform validate)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(docker service *)",
      "Bash(ansible-playbook --check *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl rollout status *)",
      "Bash(kubectl rollout history *)",
      "Bash(helm diff *)",
      "Bash(helm list *)",
      "Bash(helm upgrade --install * --dry-run)",
      "Bash(bash -n *)",
      "Read(./terraform/*)",
      "Read(./docker/*)",
      "Read(./.env.example)",
      "Read(./stack.env)",
      "Grep(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(chmod 000 *)",
      "Bash(terraform apply)",
      "Bash(terraform destroy)",
      "Bash(docker push *)",
      "Bash(docker rm -f *)",
      "Bash(ansible-playbook [^-]*[^-][^-c][^-])",
      "Bash(kubectl delete *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(helm upgrade --install * --values *)",
      "Write(/etc/*)",
      "Write(/root/*)",
      "Write(*.prod.yml)",
      "Write(*.prod.yaml)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(terraform plan|terraform show|terraform state list)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'Plan:|No changes|Resource will be|Error:|Warning:' || echo 'Plan summary not found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(docker logs|docker compose logs)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'ERROR|WARN|Exception|failed|error' || echo 'No errors found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(docker ps|docker service ls|docker inspect)",
        "hooks": [
          {
            "type": "command",
            "command": "tail -20",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(ansible-playbook --check)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'CHANGED|FAILED|ok|ERROR|TASK' || echo 'Run summary not captured'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(kubectl diff *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E '^[+-]' | grep -v '^---\\|^+++' || echo 'No diff output'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(kubectl logs *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'ERROR|WARN|Exception|panic|fatal|error' || echo 'No errors found'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(kubectl rollout status *)",
        "hooks": [
          {
            "type": "command",
            "command": "grep -E 'successfully rolled out|Waiting|error' || echo 'Rollout status not captured'",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "everything-claude-code": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/everything-claude-code.git"
      }
    }
  },
  "autoMemoryDirectory": ".claude/memory",
  "compactOnSave": true,
  "enabledPlugins": {
    "everything-claude-code@everything-claude-code": true
  }
}
